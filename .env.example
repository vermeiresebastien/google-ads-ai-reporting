# Copy to .env. Never commit real secrets.

DATABASE_URL=postgresql+psycopg://gads:gads@localhost:5432/gads
REDIS_URL=redis://localhost:6379/0

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Generate a long random string. Used to sign login JWTs and OAuth state.
JWT_SECRET=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

# Set true only for local tests. Never enable against a real account.
GOOGLE_ADS_USE_FAKE=false

SYNC_INITIAL_LOOKBACK_DAYS=90
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Without this key the API still answers from the analytics tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional.
SENTRY_DSN=

# Local only. Exposes POST /api/demo/seed when true.
ENABLE_DEMO_SEED=false

# Paste a user JWT here so the MCP server can call the API as that user.
GADS_API_BASE_URL=http://localhost:8000
GADS_API_TOKEN=
