# Copy to .env. Never commit real secrets.

DATABASE_URL=postgresql+psycopg://gads:gads@localhost:5432/gads
REDIS_URL=redis://localhost:6379/0

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Generate a long random string. Used to sign login JWTs and OAuth state.
JWT_SECRET=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

SYNC_INITIAL_LOOKBACK_DAYS=90
SYNC_HISTORY_LOOKBACK_DAYS=395
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Without this key the API still answers from the analytics tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional. When set, Ask runs an LLM council through OpenRouter: several models answer,
# rank each other, and a chairman writes the final answer. Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=
# Optional. Used only when OPENROUTER_API_KEY is out of requests.
OPENROUTER_BACKUP_API_KEY=
COUNCIL_MODELS=openai/gpt-5.1,google/gemini-3-pro-preview,anthropic/claude-sonnet-4.5,x-ai/grok-4
CHAIRMAN_MODEL=google/gemini-3-pro-preview

# Optional.
SENTRY_DSN=

# Paste a user JWT here so the MCP server can call the API as that user.
GADS_API_BASE_URL=http://localhost:8000
GADS_API_TOKEN=
